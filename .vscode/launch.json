{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Live webcam",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/live.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Train (synthetic)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": [
        "--epochs",
        "10"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Predict",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/predict.py",
      "args": [
        "checkpoints/best.pt",
        "${input:image}"
      ],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "image",
      "type": "promptString",
      "description": "Path to a line image"
    }
  ]
}